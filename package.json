{
  "name": "xdm",
  "private": true,
  "version": "0.1.0",
  "description": "XDM — aspirateur de site et gestionnaire de téléchargements (clone fonctionnel du Site Grabber d'IDM) ; analyse de la cible assistée par REA",
  "scripts": {
    "rea": "rea",
    "doctor": "rea doctor",
    "capabilities": "rea capabilities",
    "analyze:demo": "rea analyze-javascript-application samples/demo-electron-app --format json",
    "evidence:idm": "bash tools/collect-idman-evidence.sh",
    "triage:idm": "python3 tools/idman_triage.py",
    "extract:idm": "python3 tools/idman_extract.py",
    "classes:idm": "python3 tools/idman_classes.py",
    "function:idm": "python3 tools/idman_function.py",
    "args:idm": "python3 tools/idman_args.py",
    "symbols:idm": "python3 tools/idman_symbols.py",
    "profile:idm": "python3 tools/idman_class_profile.py",
    "attrib:idm": "python3 tools/idman_attrib.py",
    "states:idm": "python3 tools/idman_states.py",
    "io:idm": "python3 tools/idman_io.py",
    "chunks:idm": "python3 tools/idman_chunks.py",
    "filters:idm": "python3 tools/idman_filters.py",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "dl": "node bin/xdm.js",
    "grabber:idm": "python3 tools/idman_grabber.py"
  },
  "devDependencies": {
    "rea-agents": "6.8.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "type": "module",
  "bin": {
    "xdm": "bin/xdm.js"
  }
}
